<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мой сайт</title>
    <!-- Подключение Bootstrap (если есть) -->
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>
<body>

    <!-- НАВИГАЦИОННОЕ МЕНЮ -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container">
        <a class="navbar-brand" href="/">Мой сайт</a>
        <div class="navbar-nav">
          <!-- Вот здесь мы используем currentPath -->
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Главная</a>
          <a class="nav-link <%= currentPath === '/audi-a7' ? 'active' : '' %>" href="/audi-a7">Audi A7</a>
          <a class="nav-link <%= currentPath === '/audi-a6' ? 'active' : '' %>" href="/audi-a6">Audi A6</a>
          <a class="nav-link <%= currentPath === '/audi-a5' ? 'active' : '' %>" href="/audi-a5">Audi A5</a>
        </div>
      </div>
    </nav>

    <!-- БЛОК, КУДА ВСТАВЛЯЕТСЯ КОНТЕНТ СТРАНИЦ -->
    <div class="container mt-4">
        <%- body %>
    </div>

    <!-- СЧЕТЧИК ИЗ 9.4 -->
    <footer class="container mt-5">
        <p>Вы посетили страниц за эту сессию: <b><%= views %></b></p>
    </footer>

</body>
</html>